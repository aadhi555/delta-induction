#!/usr/bin/env bash

PASS=0
FAIL=0

check() {
    local description=$1
    local command=$2
    if eval "$command" &>/dev/null; then
        echo "✓ $description"
        ((PASS++))
    else
        echo "✗ $description"
        ((FAIL++))
    fi
}

echo "══════════════════════════════════"
echo "        initRoster Verification   "
echo "══════════════════════════════════"

echo ""
echo "── Groups ──────────────────────"
check "wardens group exists" "getent group wardens"
check "guards group exists" "getent group guards"
check "bashers group exists" "getent group bashers"

echo ""
echo "── Users ───────────────────────"
check "yashwant exists" "id yashwant"
check "hawk_tuah exists" "id hawk_tuah"
check "looksmaxxer exists" "id looksmaxxer"
check "skndash exists" "id skndash"
check "brainrot_timmy exists" "id brainrot_timmy"
check "sigma_grinder exists" "id sigma_grinder"

echo ""
echo "── Home directories ─────────────"
check "/home/guards exists" "ls /home/guards"
check "/home/bashers exists" "ls /home/bashers"
check "hawk_tuah home exists" "ls /home/guards/hawk_tuah"
check "looksmaxxer home exists" "ls /home/guards/looksmaxxer"
check "skndash home exists" "ls /home/bashers/skndash"
check "brainrot_timmy home exists" "ls /home/bashers/brainrot_timmy"
check "sigma_grinder home exists" "ls /home/bashers/sigma_grinder"

echo ""
echo "── Drop_Zone ────────────────────"
check "skndash Drop_Zone exists" "ls /home/bashers/skndash/Drop_Zone"
check "brainrot_timmy Drop_Zone exists" "ls /home/bashers/brainrot_timmy/Drop_Zone"
check "sigma_grinder Drop_Zone exists" "ls /home/bashers/sigma_grinder/Drop_Zone"

echo ""
echo "── SSH keys ─────────────────────"
check "yashwant authorized_keys exists" "ls /home/yashwant/.ssh/authorized_keys"
check "hawk_tuah authorized_keys exists" "ls /home/guards/hawk_tuah/.ssh/authorized_keys"
check "looksmaxxer authorized_keys exists" "ls /home/guards/looksmaxxer/.ssh/authorized_keys"
check "skndash authorized_keys exists" "ls /home/bashers/skndash/.ssh/authorized_keys"
check "brainrot_timmy authorized_keys exists" "ls /home/bashers/brainrot_timmy/.ssh/authorized_keys"
check "sigma_grinder authorized_keys exists" "ls /home/bashers/sigma_grinder/.ssh/authorized_keys"

echo ""
echo "── Password locked (bashers) ────"
check "skndash password locked" "[[ \$(passwd -S skndash | awk '{print \$2}') == 'L' ]]"
check "brainrot_timmy password locked" "[[ \$(passwd -S brainrot_timmy | awk '{print \$2}') == 'L' ]]"
check "sigma_grinder password locked" "[[ \$(passwd -S sigma_grinder | awk '{print \$2}') == 'L' ]]"

echo ""
echo "── Avatars ──────────────────────"
check "yashwant avatar exists" "ls /home/yashwant/.avatar.txt"
check "hawk_tuah avatar exists" "ls /home/guards/hawk_tuah/.avatar.txt"
check "looksmaxxer avatar exists" "ls /home/guards/looksmaxxer/.avatar.txt"
check "skndash avatar exists" "ls /home/bashers/skndash/.avatar.txt"
check "brainrot_timmy avatar exists" "ls /home/bashers/brainrot_timmy/.avatar.txt"
check "sigma_grinder avatar exists" "ls /home/bashers/sigma_grinder/.avatar.txt"

echo ""
echo "── Aliases in .bashrc ───────────"
check "skndash has cap alias" "grep -q 'alias cap' /home/bashers/skndash/.bashrc"
check "skndash has sus alias" "grep -q 'alias sus' /home/bashers/skndash/.bashrc"
check "skndash has mog alias" "grep -q 'alias mog' /home/bashers/skndash/.bashrc"
check "brainrot_timmy has aliases" "grep -q 'alias cap' /home/bashers/brainrot_timmy/.bashrc"
check "sigma_grinder has aliases" "grep -q 'alias cap' /home/bashers/sigma_grinder/.bashrc"

echo ""
echo "── Avatar prints on login ───────"
check "skndash bashrc has avatar print" "grep -q 'avatar.txt' /home/bashers/skndash/.bashrc"
check "hawk_tuah bashrc has avatar print" "grep -q 'avatar.txt' /home/guards/hawk_tuah/.bashrc"
check "yashwant bashrc has avatar print" "grep -q 'avatar.txt' /home/yashwant/.bashrc"

echo ""
echo "── ACLs ─────────────────────────"
check "guards have rx on bashers dir" "getfacl /home/bashers | grep -q 'group:guards:r-x'"

echo ""
echo "══════════════════════════════════"
echo "  PASSED: $PASS  |  FAILED: $FAIL"
echo "══════════════════════════════════"
